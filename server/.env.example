PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/digital-heroes
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Demo accounts created by `npm run seed:admin`
ADMIN_EMAIL=admin@digitalheroes.test
ADMIN_PASSWORD=Admin@12345
DEMO_EMAIL=customer@digitalheroes.test
DEMO_PASSWORD=Customer@12345

# Stripe (leave empty in development: a mock checkout marks the order paid)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=false

# Email (leave SMTP_HOST empty: emails are logged to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Digital Heroes <no-reply@digitalheroes.co.in>
ADMIN_NOTIFY_EMAIL=

# Invoice header
COMPANY_NAME=Digital Heroes
COMPANY_ADDRESS=
COMPANY_TAX_ID=